{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!version\\.json|app_logo\\.png|assets/.*).*)",
      "destination": "/index.html"
    }
  ]
}
